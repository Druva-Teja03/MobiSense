# --- Accident alert emails (notify.py) ---
# Leave SMTP_HOST blank to run in DRY-RUN mode: alerts are logged to the
# alert_log table and printed to the console instead of actually being
# emailed. Fill these in with real values (e.g. a Gmail app password, or
# your college/SIH mail relay) once you're ready to send real alerts.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_FROM_EMAIL=alerts@mobisense.local
ALERT_FROM_NAME=MobiSense Alerts
